{
  "schemaVersion": 1,
  "id": "voxymobile",
  "version": "${version}",
  "name": "Voxy Mobile Reborn",
  "description": "Mobile-oriented hierarchical LOD renderer for Minecraft 1.20.1 with optional GLES seam-bound debug overlay (Stage 52).",
  "authors": [
    "Brezze"
  ],
  "environment": "client",
  "mixins": [ "voxymobile.mixins.json" ],
  "entrypoints": {
    "client": [
      "dev.brezze.voxymobile.fabric.VoxyMobileClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.14.22",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
}
